BO_ 2024 OBD2_ResponsePayload: 64 ECU
 SG_ Engine_Load : 0|8@1+ (0.3921568627,0) [0|100] "%" ECU
 SG_ Coolant_Temp : 0|8@1+ (1,-40) [-40|215] "degC" ECU
 SG_ STFT_Bank1 : 0|8@1+ (0.78125,-100) [-100|99.2] "%" ECU
 SG_ LTFT_Bank1 : 0|8@1+ (0.78125,-100) [-100|99.2] "%" ECU
 SG_ Fuel_Pressure : 0|8@1+ (3,0) [0|765] "kPa" ECU
 SG_ MAP_Pressure : 0|8@1+ (1,0) [0|255] "kPa" ECU
 SG_ Engine_RPM : 7|16@0+ (0.25,0) [0|16383.75] "rpm" ECU
 SG_ Vehicle_Speed : 0|8@1+ (1,0) [0|255] "km/h" ECU
 SG_ Timing_Advance : 0|8@1+ (0.5,-64) [-64|63.5] "deg before TDC" ECU
 SG_ Intake_Air_Temp : 0|8@1+ (1,-40) [-40|215] "degC" ECU
 SG_ MAF_Flow_Rate : 7|16@0+ (0.01,0) [0|655.35] "g/s" ECU
 SG_ Throttle_Position : 0|8@1+ (0.3921568627,0) [0|100] "%" ECU
 SG_ Engine_Run_Time : 7|16@0+ (1,0) [0|65535] "s" ECU
 SG_ Fuel_Tank_Level : 0|8@1+ (0.3921568627,0) [0|100] "%" ECU
 SG_ Baro_Pressure : 0|8@1+ (1,0) [0|255] "kPa" ECU
 SG_ Module_Voltage : 7|16@0+ (0.001,0) [0|65.535] "V" ECU
 SG_ Fuel_Type : 0|8@1+ (1,0) [0|23] "" ECU
 SG_ Fuel_Rate : 7|16@0+ (0.05,0) [0|3276.75] "L/h" ECU
 SG_ VIN : 8|136@1+ (1,0) [0|0] "" ECU

