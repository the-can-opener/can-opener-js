{
  "name": "can-opener-js",
  "version": "0.1.0",
  "description": "Signal-first virtual vehicle library with per-vehicle DBC bindings, transport, APIs, and state.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "can",
    "dbc",
    "vehicle",
    "ble",
    "uds"
  ],
  "license": "MIT",
  "dependencies": {
    "valtio": "^2.2.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
