{
  "name": "can-opener-js",
  "version": "0.1.0",
  "description": "Signal-first virtual vehicle library with per-vehicle DBC bindings, transport, APIs, and state.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js",
      "require": "./dist/transport/index.cjs"
    },
    "./ble": {
      "types": "./dist/ble/index.d.ts",
      "import": "./dist/ble/index.js",
      "require": "./dist/ble/index.cjs"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js",
      "require": "./dist/security/index.cjs"
    },
    "./react-native-ble": {
      "types": "./dist/react-native-ble/index.d.ts",
      "import": "./dist/react-native-ble/index.js",
      "require": "./dist/react-native-ble/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:slcan": "npm --prefix examples/slcan-web run dev"
  },
  "keywords": [
    "can",
    "dbc",
    "vehicle",
    "ble",
    "uds"
  ],
  "license": "MIT",
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "valtio": "^2.2.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
